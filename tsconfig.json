{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "strict": true,
    "skipLibCheck": true, "allowImportingTsExtensions": false,
    "esModuleInterop": true, "declaration": false
  },
  "include": ["src/**/*.ts"]
}

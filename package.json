{
  "name": "codyssey",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "codyssey": "./dist/cli.js"
  },
  "scripts": {
    "init": "node --experimental-strip-types src/cli.ts init",
    "start": "node --experimental-strip-types src/cli.ts start",
    "scan": "node --experimental-strip-types src/cli.ts scan",
    "status": "node --experimental-strip-types src/cli.ts status",
    "test": "node --experimental-strip-types test/run.ts && node --experimental-strip-types test/e2e.ts",
    "build": "tsc -p .",
    "bench": "node --experimental-strip-types bench/run.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "tree-sitter-wasm": "^1.1.4",
    "web-tree-sitter": "^0.26.12",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "description": "Architecture guardrails for AI coding agents - blocks edits that break your architecture. Static analysis, zero LLM calls."
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"D:/workspace/CODYSSEY/src/cli.ts\" ensure --root \"${CLAUDE_PROJECT_DIR}\" --port 7891",
            "async": true,
            "timeout": 20,
            "statusMessage": "codyssey 준비 중..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7891/session",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7891/pre",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7891/post",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7891/prompt",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
